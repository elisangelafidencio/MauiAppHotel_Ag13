<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre">

    <ScrollView>
        <VerticalStackLayout Padding="30,50" Spacing="25" VerticalOptions="Center">

            <Label Text="Sobre o Aplicativo"
                   FontFamily="Kalam-Bold"
                   FontSize="32"
                   TextColor="#512BD4"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="2" Color="#512BD4" WidthRequest="100" HorizontalOptions="Center" />

            <Label Text="Desenvolvido por: Elisangela Fidencio"
                   FontSize="18"
                   HorizontalOptions="Center" />

            <Label Text="Ano de desenvolvimento: 2026"
                   FontSize="18"
                   HorizontalOptions="Center" />

            <Label Text=""
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,0" />

            <Button Text="Voltar"
                    Clicked="OnVoltarClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="10"
                    HorizontalOptions="Center"
                    WidthRequest="150"
                    Margin="0,30,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>